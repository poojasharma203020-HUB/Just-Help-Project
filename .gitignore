# ---- Node / React (apps/web) ----
node_modules/
dist/
.vite/
*.local

# ---- Flutter (apps/mobile) ----
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
*.iml

# Generated by build_runner — regenerate, don't commit
*.g.dart
*.freezed.dart

# ---- Secrets: never commit ----
.env
.env.local
apps/mobile/android/local.properties
apps/mobile/android/key.properties
apps/mobile/android/upload-keystore.jks
apps/mobile/android/app/google-services.json
apps/mobile/ios/Runner/GoogleService-Info.plist
apps/mobile/lib/firebase_options.dart

# env/*.json hold real keys once you fill them in. The examples are
# committed; your filled-in copies should not be.
apps/mobile/env/prod.json
apps/mobile/env/staging.json

# ---- OS ----
.DS_Store
Thumbs.db
